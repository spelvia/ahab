{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "builtin",
	"description": "The app's own screens, bundled with it: every command. No remote origin gets this; servers get only the bridge (src/bridge.rs).",
	"windows": ["*"],
	"permissions": [
		"core:default",
		"allow-boot",
		"allow-reach",
		"allow-pair",
		"allow-ask",
		"allow-wait",
		"allow-check-server",
		"allow-open-server",
		"allow-open-server-window",
		"allow-show-screen",
		"allow-remove-server",
		"allow-rename-server",
		"allow-this-computer",
		"allow-run-here",
		"allow-agents-here",
		"allow-open-in-browser",
		"allow-use-existing",
		"allow-start-here",
		"allow-stop-here",
		"allow-join-server",
		"allow-join-with-code",
		"allow-leave",
		"allow-parse-link",
		"allow-take-link",
		"allow-get-settings",
		"allow-set-settings",
		"allow-check-for-updates",
		"allow-quit",
		"core:event:allow-listen",
		"core:event:allow-unlisten"
	]
}
