---
/**
 * The landing page, at /. The documentation is Starlight's, under /docs.
 * Every claim here is one the README or the documentation makes.
 */
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";

import AgentLogos from "../components/landing/AgentLogos.astro";
import { ACP, NATIVE } from "../components/landing/agents";
import Icon from "../components/landing/Icon.astro";
import Shot from "../components/landing/Shot.astro";
import Weave from "../components/landing/Weave.astro";
import agentsDark from "../assets/landing/agents-dark.png";
import agentsLight from "../assets/landing/agents-light.png";
import diffsDark from "../assets/landing/diffs-dark.png";
import diffsLight from "../assets/landing/diffs-light.png";
import editorDark from "../assets/landing/editor-dark.png";
import editorLight from "../assets/landing/editor-light.png";
import phoneChatDark from "../assets/landing/phone-chat-dark.png";
import phoneChatLight from "../assets/landing/phone-chat-light.png";
import phonePermissionDark from "../assets/landing/phone-permission-dark.png";
import phonePermissionLight from "../assets/landing/phone-permission-light.png";
import terminalDark from "../assets/landing/terminal-dark.png";
import terminalLight from "../assets/landing/terminal-light.png";

const INSTALL = "curl -fsSL https://useahab.com/install.sh | sh";
const GITHUB = "https://github.com/spelvia/ahab";
const RELEASES = `${GITHUB}/releases`;

const DESKTOP = { widths: [800, 1400, 2400], sizes: "(min-width: 1200px) 1120px, 100vw" };
const PHONE = { widths: [390, 780, 1170], sizes: "(min-width: 900px) 260px, 45vw" };

const tabs = [
	{
		id: "agents",
		label: "Agents",
		caption: "A finished turn: the agent's plan, what it read and changed, and the tests it ran.",
		dark: agentsDark,
		light: agentsLight,
		alt: "An agent session in Ahab: the prompt, the agent's finished plan, the files it read and edited, and the commands it ran.",
	},
	{
		id: "diffs",
		label: "Changes",
		caption: "Your changes side by side, staged a hunk or a line at a time, with the commit graph beside them.",
		dark: diffsDark,
		light: diffsLight,
		alt: "An edit the agent made, open as a diff inside the conversation.",
	},
	{
		id: "editor",
		label: "Editor",
		caption: "Read and edit the files beside the conversation, in tabs and split panes.",
		dark: editorDark,
		light: editorLight,
		alt: "The conversation beside an editor with the file the agent wrote.",
	},
	{
		id: "terminal",
		label: "Terminal",
		caption: "The conversation, the file and a terminal together: a real shell in the same project, on the same machine as the agent.",
		dark: terminalDark,
		light: terminalLight,
		alt: "The conversation, an editor and a terminal side by side.",
	},
];

const faq = [
	{
		q: "Does my code leave my machines?",
		a: "Ahab runs on your computers: the server keeps its state in its own database, and agents work in your project folders on your machines. The agents talk to their providers as they do without Ahab.",
		link: { href: "/docs/security/", label: "Security" },
	},
	{
		q: "Which agents work with it?",
		a: "Claude Code, Codex, Pi, and any agent that speaks the Agent Client Protocol. Each runs as you installed and signed it in; Ahab shows its models, modes and questions.",
		link: { href: "/docs/", label: "Introduction" },
	},
	{
		q: "Can I use it from my phone?",
		a: "Yes: the web app works on phones. Each browser is paired with the server once; reach it over HTTPS, a trusted reverse proxy or your tailnet.",
		link: { href: "/docs/security/#connections", label: "Connections" },
	},
	{
		q: "How do I add another computer?",
		a: "Run `ahab machines add you@host`: it installs Ahab on that computer over SSH and joins it to your server, so agents can work in its folders too.",
		link: { href: "/docs/installation/cli/", label: "The CLI" },
	},
	{
		q: "Is it ready?",
		a: "It is a release candidate. It works day to day, but data formats may still change before 0.1.0.",
		link: { href: RELEASES, label: "Releases" },
	},
];
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Ahab: your agents, on your machines</title>
		<meta
			name="description"
			content="A self-hosted workspace for Claude Code, Codex, Pi and any ACP agent, with files, terminals and Git beside them."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<script is:inline>
			// The theme the docs remember (Starlight's), else the system's.
			const saved = localStorage.getItem("starlight-theme");
			const light = saved ? saved === "light" : matchMedia("(prefers-color-scheme: light)").matches;
			document.documentElement.dataset.theme = light ? "light" : "dark";
		</script>
	</head>
	<body>
		<header class="top">
			<a class="brand" href="/">
				<img class="mark mark-dark" src="/ahab-mark-white.svg" alt="" />
				<img class="mark mark-light" src="/ahab-mark.svg" alt="" />
				Ahab
			</a>
			<nav aria-label="Main">
				<a href="/docs/">Docs</a>
				<a href="/docs/plugins/">Plugin SDK</a>
				<a href={RELEASES}>Releases</a>
				<a href={GITHUB}>GitHub</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<div class="hero-text">
					<a class="pill" href={RELEASES}>0.1.0-rc.1 · release candidate</a>
					<h1>Your agents, on your machines.</h1>
					<p class="lead">
						A self-hosted workspace for Claude Code, Codex, Pi and any ACP agent, with files,
						terminals and Git beside them. Run it on your computer; use it from your phone.
					</p>
					<div class="install" aria-label="Install Ahab">
						<div class="command">
							<code><span class="prompt">$</span> {INSTALL}</code>
							<button type="button" class="copy" data-copy={INSTALL}>Copy</button>
						</div>
						<div class="command">
							<code><span class="prompt">$</span> ahab up</code>
							<button type="button" class="copy" data-copy="ahab up">Copy</button>
						</div>
						<p class="note">Linux (x86_64, arm64) and macOS on Apple silicon. No root needed.</p>
					</div>
					<div class="actions">
						<a class="button primary" href="/docs/">Read the docs</a>
						<a class="button" href={GITHUB}>View on GitHub</a>
					</div>
				</div>
				<div class="hero-mark">
					<Weave size={300} />
				</div>
			</section>

			<section class="recording" aria-label="Ahab at work">
				<figure class="desktop-frame enlargeable">
					<!-- Loaded once near the screen, playing while on it; the script sets the poster for the theme and size. -->
					<video
						id="hero-video"
						muted
						loop
						playsinline
						preload="none"
						width="1600"
						height="1000"
						aria-label="A recording of Ahab: an agent session, its changes, the editor and a terminal."
					>
						<source type="video/webm" />
						<source type="video/mp4" />
					</video>
					<button type="button" class="play" hidden aria-label="Play the recording">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
					</button>
					<button type="button" class="enlarge" data-enlarge aria-label="Enlarge the recording">
						<span class="enlarge-hint">Tap to enlarge</span>
					</button>
					<script is:inline>
						// The recording in the page's theme and size, loaded near the
						// screen and playing only while on it; with reduced motion, it
						// waits for the play button.
						(() => {
							const video = document.getElementById("hero-video");
							const play = video.parentElement.querySelector(".play");
							const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
							let near = false;
							let seen = false;
							let started = !still;
							const variant = () => {
								const theme = document.documentElement.dataset.theme === "light" ? "light" : "dark";
								const size = innerWidth < 900 ? "-960" : "";
								return { theme, size, key: theme + size };
							};
							const pick = () => {
								const { theme, size, key } = variant();
								video.poster = `/landing/hero-${theme}-poster${size}.webp`;
								if (!near || video.dataset.variant === key) return;
								video.dataset.variant = key;
								const [webm, mp4] = video.querySelectorAll("source");
								webm.src = `/landing/hero-${theme}${size}.webm`;
								mp4.src = `/landing/hero-${theme}${size}.mp4`;
								video.load();
								if (seen && started) video.play().catch(() => {});
							};
							play.hidden = !still;
							play.addEventListener("click", () => {
								started = true;
								play.hidden = true;
								near = true;
								pick();
								video.play().catch(() => {});
							});
							pick();
							new IntersectionObserver(
								([entry]) => {
									if (entry.isIntersecting && !near) {
										near = true;
										pick();
									}
								},
								{ rootMargin: "600px 0px" },
							).observe(video);
							new IntersectionObserver(
								([entry]) => {
									seen = entry.isIntersecting;
									if (seen && started) video.play().catch(() => {});
									else video.pause();
								},
								{ threshold: 0.15 },
							).observe(video);
							new MutationObserver(pick).observe(document.documentElement, {
								attributes: true,
								attributeFilter: ["data-theme"],
							});
							matchMedia("(max-width: 899px)").addEventListener("change", pick);
						})();
					</script>
				</figure>
			</section>

			<section class="showcase" aria-labelledby="features-heading">
				<h2 id="features-heading" class="center">A closer look</h2>
				<div class="tabs" role="tablist" aria-label="Features">
					{
						tabs.map((tab, i) => (
							<button
								type="button"
								role="tab"
								id={`tab-${tab.id}`}
								aria-controls={`panel-${tab.id}`}
								aria-selected={i === 0 ? "true" : "false"}
								tabindex={i === 0 ? 0 : -1}
							>
								{tab.label}
							</button>
						))
					}
					<button
						type="button"
						role="tab"
						id="tab-phone"
						aria-controls="panel-phone"
						aria-selected="false"
						tabindex="-1"
					>
						Phone
					</button>
				</div>
				{
					tabs.map((tab, i) => (
						<div
							class="panel"
							role="tabpanel"
							id={`panel-${tab.id}`}
							aria-labelledby={`tab-${tab.id}`}
							hidden={i !== 0}
						>
							<div class="stage">
								<figure class="desktop-frame enlargeable">
									<button
										type="button"
										class="enlarge"
										data-enlarge
										aria-label={`Enlarge the screenshot: ${tab.alt}`}
									>
										<span class="enlarge-hint">Tap to enlarge</span>
									</button>
									<Shot
										dark={tab.dark}
										light={tab.light}
										alt={tab.alt}
										eager={i === 0}
										{...DESKTOP}
									/>
								</figure>
								{i === 0 && (
									<figure class="phone-frame floating">
										<Shot
											dark={phoneChatDark}
											light={phoneChatLight}
											alt="The same session on a phone."
											eager
											{...PHONE}
										/>
									</figure>
								)}
							</div>
							<p class="caption">{tab.caption}</p>
						</div>
					))
				}
				<div class="panel" role="tabpanel" id="panel-phone" aria-labelledby="tab-phone" hidden>
					<div class="phones">
						<figure class="phone-frame">
							<Shot
								dark={phoneChatDark}
								light={phoneChatLight}
								alt="An agent session on a phone."
								{...PHONE}
							/>
						</figure>
						<figure class="phone-frame">
							<Shot
								dark={phonePermissionDark}
								light={phonePermissionLight}
								alt="An agent asking to run git push, with Allow and Reject, on a phone."
								{...PHONE}
							/>
						</figure>
					</div>
					<p class="caption">
						The same sessions on your phone: follow a turn, and answer when an agent asks.
					</p>
				</div>
			</section>

			<section class="trust" aria-label="In short">
				<ul>
					<li>Open source, Apache 2.0</li>
					<li>Runs on your machines</li>
					<li>Only paired browsers get in</li>
					<li>SQLite or Postgres</li>
					<li>The agents you already use</li>
				</ul>
			</section>

			<section class="block agents">
				<h2>Bring the agents you have.</h2>
				<p>
					Ahab drives the coding agents you already installed and signed in to. Each keeps its own
					models, modes, skills and permissions; Ahab shows them, and answers their questions
					in the conversation.
				</p>
				<AgentLogos agents={NATIVE} large />
				<h3>And every agent in the ACP registry</h3>
				<p class="small">
					{ACP.length} agents that speak the Agent Client Protocol, from the registry Ahab ships with,
					or any other with its own command.
				</p>
				<AgentLogos agents={ACP} />
			</section>

			<section class="block how">
				<h2>How it works</h2>
				<p>
					The <strong>server</strong> keeps Ahab's state and serves the web app. A{" "}
					<strong>daemon</strong> on each machine runs the agents, files and terminals in its project
					folders. Browsers and phones are paired with the server; machines connect out to it.
				</p>
				<div class="setups">
					<article class="setup">
						<h3>The easy way: everything on your laptop</h3>
						<div class="diagram" aria-hidden="true">
							<div class="node">
								<Icon name="smartphone" />
								<span class="node-title">Your phone</span>
								<span class="node-detail">paired</span>
							</div>
							<div class="link"></div>
							<div class="node strong">
								<Icon name="laptop" />
								<span class="node-title">Your laptop</span>
								<span class="node-detail">server · daemon · agents</span>
							</div>
						</div>
						<p class="command-line"><code>ahab up</code></p>
						<p class="small">
							Runs the server and this computer's daemon as a login service, and opens the web app,
							already paired. Pair your phone with the QR code under Settings → Clients.
						</p>
					</article>
					<article class="setup">
						<h3>Always on: a server at home</h3>
						<div class="diagram" aria-hidden="true">
							<div class="node-stack">
								<div class="node">
									<Icon name="laptop" />
									<span class="node-title">Laptop</span>
								</div>
								<div class="node">
									<Icon name="smartphone" />
									<span class="node-title">Phone</span>
								</div>
							</div>
							<div class="link"></div>
							<div class="node strong">
								<Icon name="server" />
								<span class="node-title">Home server</span>
								<span class="node-detail">server · daemon</span>
							</div>
							<div class="link"></div>
							<div class="node">
								<Icon name="monitor" />
								<span class="node-title">Workstation</span>
								<span class="node-detail">daemon · agents</span>
							</div>
						</div>
						<p class="command-line"><code>ahab login ssh://you@homelab</code></p>
						<p class="command-line"><code>ahab machines add you@workstation</code></p>
						<p class="small">
							Installs and starts the server on a homelab box or an always-on PC over SSH, and pairs
							your command line; then joins the computers your agents should work on. Reach it from
							your laptop and phone.
						</p>
					</article>
				</div>
				<a class="text-link" href="/docs/installation/">More about servers and machines →</a>
			</section>

			<section class="block plugins">
				<div>
					<h2>Make it yours.</h2>
					<p>
						Ahab's core is small. Agents, files, terminals and Git are bundled plugins, and yours use
						the same contracts: views, commands, settings, and code that runs on each machine.
					</p>
					<a class="text-link" href="/docs/plugins/quick-start/">Build a plugin in the quick start →</a>
				</div>
				<pre class="code"><code><span class="c">// src/shared/index.ts: a command both entries use</span>
<span class="k">export const</span> hello = defineCommand(&#123;
	name: <span class="s">"hello"</span>,
	target: <span class="s">"machine"</span>,
	input: z.object(&#123; name: z.string().default(<span class="s">"world"</span>) &#125;),
	output: z.object(&#123; text: z.string() &#125;),
&#125;);

<span class="c">// src/daemon/index.ts: answered on each machine</span>
<span class="k">export default</span> definePlugin((ahab) =&gt; &#123;
	ahab.commands.handle(hello, (&#123; name &#125;) =&gt; (&#123;
		text: <span class="s">`Hello, $&#123;name&#125;, from $&#123;ahab.machine&#125;.`</span>,
	&#125;));
&#125;);</code></pre>
			</section>

			<section class="block faq">
				<h2>Questions</h2>
				{
					faq.map((item) => (
						<details>
							<summary>{item.q}</summary>
							<p>
								{item.a.split("`").map((part, i) => (i % 2 ? <code>{part}</code> : part))}{" "}
								<a href={item.link.href}>{item.link.label} →</a>
							</p>
						</details>
					))
				}
			</section>

			<section class="closing">
				<Weave size={120} />
				<h2>Start on your computer.</h2>
				<div class="command">
					<code><span class="prompt">$</span> {INSTALL}</code>
					<button type="button" class="copy" data-copy={INSTALL}>Copy</button>
				</div>
				<a class="button primary" href="/docs/installation/">Installation guide</a>
			</section>
		</main>

		<footer class="bottom">
			<span>Ahab · <a href={`${GITHUB}/blob/main/LICENSE`}>Apache 2.0</a></span>
			<nav aria-label="Footer">
				<a href="/docs/">Docs</a>
				<a href="/docs/plugins/">Plugin SDK</a>
				<a href="/docs/security/">Security</a>
				<a href={RELEASES}>Releases</a>
				<a href={GITHUB}>GitHub</a>
			</nav>
		</footer>

		<script is:inline>
			// Tabs: click, or arrow keys between them.
			const tabs = [...document.querySelectorAll('[role="tab"]')];
			const select = (tab) => {
				for (const other of tabs) {
					const on = other === tab;
					other.setAttribute("aria-selected", String(on));
					other.tabIndex = on ? 0 : -1;
					document.getElementById(other.getAttribute("aria-controls")).hidden = !on;
				}
			};
			for (const tab of tabs) {
				tab.addEventListener("click", () => select(tab));
				tab.addEventListener("keydown", (event) => {
					const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
					if (!step) return;
					const next = tabs[(tabs.indexOf(tab) + step + tabs.length) % tabs.length];
					select(next);
					next.focus();
				});
			}
			// Copy buttons.
			for (const button of document.querySelectorAll("[data-copy]")) {
				button.addEventListener("click", async () => {
					await navigator.clipboard.writeText(button.dataset.copy);
					button.textContent = "Copied";
					setTimeout(() => (button.textContent = "Copy"), 1500);
				});
			}
		</script>
		<dialog id="viewer" aria-label="Enlarged view">
			<div class="viewer-scroll"></div>
			<button type="button" class="viewer-close" aria-label="Close">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
			</button>
		</dialog>
		<script is:inline>
			// One viewer for every screenshot and the recording: a modal dialog
			// (it keeps focus inside and closes on Esc), closed by its button or
			// the backdrop, with the page still behind it.
			(() => {
				const viewer = document.getElementById("viewer");
				const scroll = viewer.querySelector(".viewer-scroll");
				let opener = null;
				const close = () => viewer.close();
				for (const button of document.querySelectorAll("[data-enlarge]")) {
					button.addEventListener("click", () => {
						const frame = button.closest("figure");
						const video = frame.querySelector("video");
						scroll.replaceChildren();
						if (video) {
							const large = document.createElement("video");
							for (const name of ["muted", "loop", "playsInline", "controls"]) large[name] = true;
							// The full-size recording, in the page's theme.
							const theme = document.documentElement.dataset.theme === "light" ? "light" : "dark";
							large.poster = `/landing/hero-${theme}-poster.webp`;
							for (const type of ["webm", "mp4"]) {
								const source = document.createElement("source");
								source.src = `/landing/hero-${theme}.${type}`;
								source.type = `video/${type}`;
								large.append(source);
							}
							large.setAttribute("aria-label", video.getAttribute("aria-label"));
							scroll.append(large);
							video.pause();
							large.play().catch(() => {});
						} else {
							const shown = [...frame.querySelectorAll("img")].find((img) => img.offsetParent);
							const large = document.createElement("img");
							large.src = shown.currentSrc || shown.src;
							large.alt = shown.alt;
							scroll.append(large);
						}
						opener = button;
						document.documentElement.classList.add("viewing");
						viewer.showModal();
						scroll.scrollLeft = 0;
					});
				}
				viewer.querySelector(".viewer-close").addEventListener("click", close);
				// A click on the backdrop lands on the dialog or its scroll area, not the media.
				viewer.addEventListener("click", (event) => {
					if (event.target === viewer || event.target === scroll) close();
				});
				viewer.addEventListener("close", () => {
					scroll.replaceChildren();
					document.documentElement.classList.remove("viewing");
					opener?.focus();
					const hero = document.getElementById("hero-video");
					if (hero.dataset.variant && hero.getBoundingClientRect().top < innerHeight) hero.play().catch(() => {});
				});
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #171716;
		--bg-raised: #1d1d1c;
		--surface: #232322;
		--hairline: #30302e;
		--text: #c1c1bd;
		--strong: #f2f2f0;
		--muted: #989894;
		--accent: #eeeeea;
		--accent-text: #171716;
		--code-k: #c9b18a;
		--code-s: #9fc3a5;
		--code-c: #7b7b76;
		--sans: "Inter Variable", system-ui, sans-serif;
		--mono: "JetBrains Mono Variable", ui-monospace, monospace;
		color-scheme: dark;
	}
	:root[data-theme="light"] {
		--bg: #fafaf7;
		--bg-raised: #f5f5f0;
		--surface: #efefe9;
		--hairline: #ddddd5;
		--text: #444440;
		--strong: #20201e;
		--muted: #62625c;
