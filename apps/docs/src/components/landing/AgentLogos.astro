---
/**
 * Agents as logo tiles: tinted to the page, in their own colour on hover;
 * a lettermark where no logo is at hand (see the agents folder's README).
 */
import type { Agent } from "./agents";

interface Props {
	agents: Agent[];
	large?: boolean;
}
const { agents, large = false } = Astro.props;

const files = import.meta.glob<string>("../../assets/landing/agents/*.svg", {
	query: "?raw",
	import: "default",
	eager: true,
});
const logo = (name: string) => {
	const svg = files[`../../assets/landing/agents/${name}.svg`];
	return svg
		?.replace(/<title>.*?<\/title>/, "")
		.replace("<svg ", '<svg aria-hidden="true" fill="currentColor" ');
};
const letters = (name: string) =>
	name
		.replace(/\(.*\)/, "")
		.split(/[\s-]+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((word) => word[0]?.toUpperCase())
		.join("");
---

<ul class:list={["agent-logos", { large }]}>
	{
		agents.map((agent) => (
			<li style={agent.hex ? `--brand: ${agent.hex}` : undefined}>
				<span class="logo">
					{agent.logo ? (
						<Fragment set:html={logo(agent.logo)} />
					) : (
						<span class="letters" aria-hidden="true">
							{letters(agent.name)}
						</span>
					)}
				</span>
				<span class="name">{agent.name}</span>
			</li>
		))
	}
</ul>

<style>
	.agent-logos {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.agent-logos.large {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		max-width: 560px;
	}
	li {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		padding: 16px 8px 12px;
		border: 1px solid var(--hairline);
		border-radius: 12px;
		background: var(--bg-raised);
		color: var(--muted);
		text-align: center;
		transition:
			color 150ms,
			border-color 150ms;
	}
	li:hover {
		border-color: var(--muted);
		color: var(--brand, var(--strong));
	}
	.logo {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
	}
	.large .logo {
		width: 40px;
		height: 40px;
	}
	.logo :global(svg) {
		width: 100%;
		height: 100%;
	}
	.letters {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		border: 1.5px solid currentColor;
		border-radius: 8px;
		font: 650 11px/1 var(--mono);
		letter-spacing: 0.02em;
	}
	.large .letters {
		font-size: 15px;
	}
	.name {
		color: var(--text);
		font-size: 13px;
		line-height: 1.3;
	}
	.large .name {
		color: var(--strong);
		font-weight: 600;
		font-size: 15px;
	}
	@media (max-width: 600px) {
		.agent-logos:not(.large) {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 8px;
		}
		.agent-logos:not(.large) li {
			padding: 12px 4px 10px;
		}
		.agent-logos:not(.large) .name {
			font-size: 11.5px;
		}
	}
</style>
