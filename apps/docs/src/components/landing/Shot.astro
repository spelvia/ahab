---
/**
 * A screenshot of the app in the page's theme: both are on the page, and
 * the theme shows one.
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
	dark: ImageMetadata;
	light: ImageMetadata;
	alt: string;
	widths: number[];
	sizes: string;
	eager?: boolean;
}
const { dark, light, alt, widths, sizes, eager = false } = Astro.props;
const loading = eager ? "eager" : "lazy";
---

<Picture
	class="shot shot-dark"
	src={dark}
	alt={alt}
	widths={widths}
	sizes={sizes}
	formats={["avif", "webp"]}
	loading={loading}
/>
<Picture
	class="shot shot-light"
	src={light}
	alt={alt}
	widths={widths}
	sizes={sizes}
	formats={["avif", "webp"]}
	loading={loading}
/>

<style>
	:global(.shot) {
		display: block;
		width: 100%;
		height: auto;
	}
	:global([data-theme="light"] .shot-dark),
	:global(:root:not([data-theme="light"]) .shot-light) {
		display: none;
	}
</style>
