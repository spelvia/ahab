---
/**
 * Ahab's weave mark in 3D, as the app's start-up splash shows it: each
 * strand at its own depth (they cross over and under), with an edge,
 * turning slowly; still with reduced motion.
 */
interface Props {
	/** Its width, in pixels. */
	size?: number;
}
const { size = 260 } = Astro.props;
// The splash's depths are for a 92px mark; they grow with it.
const scale = size / 92;
---

<div class="weave-mark" style={`--weave-size: ${size}px; --weave-scale: ${scale}`} aria-hidden="true">
	<svg width="0" height="0" style="position: absolute">
		<defs>
			<symbol id="landing-weave-a" viewBox="0 0 422.901866 308.883421">
				<path transform="translate(-12.985791,322.02742) scale(0.1,-0.1)" d="M3165 3201 c-133 -39 -190 -82 -408 -311 -166 -173 -176 -186 -159 -201 135 -125 468 -433 504 -467 l47 -45 82 76 c134 125 134 126 349 -95 l145 -149 -295 -287 c-450 -439 -507 -491 -564 -518 -119 -56 -90 -77 -729 520 -148 138 -273 251 -278 251 -5 0 -144 -135 -309 -300 l-301 -300 58 -55 c32 -30 200 -186 373 -345 172 -160 373 -344 445 -410 244 -226 311 -282 376 -313 221 -108 446 -74 631 95 215 196 1080 1030 1105 1066 92 128 114 208 120 437 12 453 -30 630 -187 790 -140 143 -531 478 -598 513 -128 68 -279 85 -407 48z" />
			</symbol>
			<symbol id="landing-weave-b" viewBox="0 0 422.901866 308.883421">
				<path transform="translate(-12.985791,322.02742) scale(0.1,-0.1)" d="M1490 3165 c-116 -38 -165 -77 -512 -415 -177 -173 -399 -389 -493 -480 -210 -204 -236 -235 -286 -335 -111 -224 -88 -469 65 -698 56 -85 186 -231 236 -267 l28 -20 -10 37 c-17 63 -5 174 24 224 24 40 768 780 928 924 105 94 182 121 255 91 34 -14 344 -295 762 -690 l43 -40 285 285 c157 156 284 289 283 295 -2 7 -73 76 -159 155 -85 79 -292 271 -460 425 -412 381 -480 439 -564 479 -132 62 -290 73 -425 30z" />
			</symbol>
			<symbol id="landing-weave-c" viewBox="0 0 422.901866 308.883421">
				<path transform="translate(-12.985791,322.02742) scale(0.1,-0.1)" d="M1019 1128 c-293 -306 -323 -351 -349 -513 -61 -382 363 -623 695 -395 26 18 144 128 263 246 l217 214 -56 53 c-318 297 -600 557 -607 557 -4 0 -77 -73 -163 -162z" />
			</symbol>
		</defs>
	</svg>
	<div class="weave">
		<svg class="edge" style="--z: -14px"><use href="#landing-weave-c" /></svg>
		<svg class="edge" style="--z: -13px"><use href="#landing-weave-c" /></svg>
		<svg class="edge" style="--z: -12px"><use href="#landing-weave-c" /></svg>
		<svg class="edge" style="--z: -11px"><use href="#landing-weave-c" /></svg>
		<svg class="edge" style="--z: -10px"><use href="#landing-weave-c" /></svg>
		<svg class="edge" style="--z: -9px"><use href="#landing-weave-c" /></svg>
		<svg class="face-c" style="--z: -8px"><use href="#landing-weave-c" /></svg>
		<svg class="edge" style="--z: -6px"><use href="#landing-weave-a" /></svg>
		<svg class="edge" style="--z: -5px"><use href="#landing-weave-a" /></svg>
		<svg class="edge" style="--z: -4px"><use href="#landing-weave-a" /></svg>
		<svg class="edge" style="--z: -3px"><use href="#landing-weave-a" /></svg>
		<svg class="edge" style="--z: -2px"><use href="#landing-weave-a" /></svg>
		<svg class="edge" style="--z: -1px"><use href="#landing-weave-a" /></svg>
		<svg class="face-a" style="--z: 0px"><use href="#landing-weave-a" /></svg>
		<svg class="edge" style="--z: 2px"><use href="#landing-weave-b" /></svg>
		<svg class="edge" style="--z: 3px"><use href="#landing-weave-b" /></svg>
		<svg class="edge" style="--z: 4px"><use href="#landing-weave-b" /></svg>
		<svg class="edge" style="--z: 5px"><use href="#landing-weave-b" /></svg>
		<svg class="edge" style="--z: 6px"><use href="#landing-weave-b" /></svg>
		<svg class="edge" style="--z: 7px"><use href="#landing-weave-b" /></svg>
		<svg class="face-b" style="--z: 8px"><use href="#landing-weave-b" /></svg>
	</div>
</div>

<style>
	.weave-mark {
		--weave-face: #f1f1ee;
		--weave-mid: #d6d6d2;
		--weave-low: #b4b4af;
		--weave-edge: #5e5e5b;
		width: var(--weave-size);
		aspect-ratio: 422.9 / 308.9;
		perspective: calc(var(--weave-size) * 5.6);
		max-width: 100%;
	}
	:global([data-theme="light"]) .weave-mark {
		--weave-face: #182321;
		--weave-mid: #33403c;
		--weave-low: #4d5955;
		--weave-edge: #a3aba7;
	}
	.weave {
		position: relative;
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
		transform: rotateX(16deg) rotateY(-24deg);
		animation: weave-turn 6s ease-in-out infinite alternate;
	}
	.weave svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		fill: var(--weave-face);
		transform: translateZ(calc(var(--z) * var(--weave-scale)));
	}
	.weave .face-a {
		fill: var(--weave-mid);
	}
	.weave .face-c {
		fill: var(--weave-low);
	}
	.weave .edge {
		fill: var(--weave-edge);
	}
	@keyframes weave-turn {
		from {
			transform: rotateX(16deg) rotateY(-24deg);
		}
		to {
			transform: rotateX(10deg) rotateY(24deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.weave {
			animation: none;
		}
	}
</style>
