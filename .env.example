# Copy to .env for development (`make setup` does this). The server and the
# Vite dev server read it.

# Keep config.toml, the database and keys in the repository's data/ folder
# instead of ~/.config/ahab and ~/.local/share/ahab.
AHAB_CONFIG_DIR=data
AHAB_DATA_DIR=data

# The database: by default data/ahab.db (SQLite), created when missing. For
# Postgres instead, start it with `make db` and uncomment this line.
# DATABASE_URL=postgres://ahab:ahab@127.0.0.1:55442/ahab

# Address the server listens on; the Vite dev server forwards /api here
AHAB_LISTEN_ADDR=127.0.0.1:8180

# A built web app to serve instead of the one in the binary; leave unset in
# development, where Vite serves the UI
# AHAB_UI_DIR=./ui/dist

# Log level and format (text or json)
RUST_LOG=info,ahab=debug
AHAB_LOG_FORMAT=text

# The Vite dev server's port
AHAB_DEV_PORT=5183

# Other names the web app's and the docs' dev servers answer to, such as a
# reverse proxy's (comma-separated)
# AHAB_DEV_HOSTS=dev.ahab.example.internal
