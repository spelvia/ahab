{
	"id": "tsc",
	"name": "tsc",
	"kind": "check",
	"languages": ["typescript", "tsx"],
	"license": "Apache-2.0",
	"homepage": "https://www.typescriptlang.org",
	"description": "TypeScript's type check of the whole project.",
	"source": {
		"type": "npm",
		"package": "typescript",
		"version": "7.0.2"
	},
	"requires": [
		{
			"runtime": "node",
			"min": 18
		}
	],
	"bin": {
		"tsc": "node_modules/.bin/tsc"
	},
	"run": {
		"command": ["tsc", "--noEmit", "--pretty", "false"],
		"rootMarkers": ["tsconfig.json"],
		"settingsFiles": ["tsconfig.json"],
		"on": ["agentTurn", "request"],
		"output": {
			"format": "pattern",
			"pattern": {
				"regexp": "^(?P<file>[^\\s(][^(]*)\\((?P<line>\\d+),(?P<column>\\d+)\\): (?P<severity>error|warning|message) (?P<code>TS\\d+): (?P<message>.*)$",
				"severities": {
					"message": "information"
				}
			}
		}
	},
	"hint": "npm install --save-dev typescript"
}
