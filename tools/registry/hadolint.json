{
	"id": "hadolint",
	"name": "Hadolint",
	"kind": "linter",
	"languages": ["dockerfile"],
	"license": "GPL-3.0-only",
	"homepage": "https://github.com/hadolint/hadolint",
	"description": "Lints Dockerfiles.",
	"source": {
		"type": "githubRelease",
		"repo": "hadolint/hadolint",
		"version": "2.15.1",
		"tag": "v${version}",
		"assets": {
			"linux-x64": {
				"file": "hadolint-linux-x86_64",
				"sha256": "c7187db94eeeeca956519a6af171adc31453941a1e777961f6e680f697c8c507"
			},
			"linux-arm64": {
				"file": "hadolint-linux-arm64",
				"sha256": "f6198ef8090f404dbb771abfee086eb8c48ac177f30da7fd3510aca35b344b5d"
			},
			"darwin-x64": {
				"file": "hadolint-macos-x86_64",
				"sha256": "ffe9bb18b23d5ed1eae50237aecdbb523d016e96da0bd4e7aa432040acfc3fde"
			},
			"darwin-arm64": {
				"file": "hadolint-macos-arm64",
				"sha256": "5c09f3213f8e40406abe048233d985eebef336d4a6a20021be47fadb6cf480a2"
			}
		}
	},
	"bin": {
		"hadolint": "hadolint"
	},
	"run": {
		"command": ["hadolint", "--no-fail", "--format", "sarif", "${path}"],
		"settingsFiles": [".hadolint.yaml"],
		"output": {
			"format": "sarif"
		}
	},
	"hint": "brew install hadolint"
}
